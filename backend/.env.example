PORT=4002
APIX_DB_PATH=./data/apix.db
APIX_HEADLESS=true
APIX_BROWSER_TIMEOUT_MS=120000
HF_TOKEN=
GEMINI_API_KEY=
# Local backend startup refreshes apix.db from Hugging Face.
# Put the write-enabled token here locally; never commit backend/.env.
# Set APIX_DB_REFRESH=true only when an explicit database refresh is needed.
# Leave unset on Render to use Playwright's installed Chromium.
# APIX_BROWSER_CHANNEL=
